# Variables para docker compose. Cópialo como .env (git lo ignora):  copy docker.env.example .env
# Tenant y App Registration de Entra ID (los mismos del frontend: VITE_AZURE_TENANT_ID / VITE_AZURE_API_CLIENT_ID).
AZURE_TENANT_ID=
AZURE_API_CLIENT_ID=

# Contraseña de root del MySQL de Docker (solo local).
MYSQL_ROOT_PASSWORD=farmaexpress

# Pagos. Webpay usa el ambiente de integración de Transbank (credenciales públicas de prueba).
# Sin token/llave, Mercado Pago y Khipu usan el simulador. Token de prueba de Mercado Pago: TEST-...
WEBPAY_API_KEY=
MERCADOPAGO_ACCESS_TOKEN=
KHIPU_API_KEY=
