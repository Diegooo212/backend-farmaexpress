# Variables de docker-compose.kafka-nube.yml (EC2 farmaexpress-kafka).
# Copiar como .env en la carpeta del repo en la EC2:  cp deploy/ec2/kafka.env.example .env  && nano .env

# IP PRIVADA de ESTA EC2 (farmaexpress-kafka): es la dirección que los brokers anuncian a las otras EC2.
# Se ve con:  hostname -I | awk '{print $1}'
KAFKA_HOST=CAMBIAR_IP_PRIVADA_DE_ESTA_EC2

# MySQL: IP PRIVADA de la EC2 farmaexpress-db y el usuario creado por instalar-mysql.sh (analytics usa su propia base)
DB_HOST=CAMBIAR_IP_PRIVADA_BASE_DE_DATOS
DB_USER=farmaexpress
DB_PASSWORD=CAMBIAR

# Microsoft Entra ID (mismos valores que el frontend)
AZURE_TENANT_ID=CAMBIAR
AZURE_API_CLIENT_ID=CAMBIAR
