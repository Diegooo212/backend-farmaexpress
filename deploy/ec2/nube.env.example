# Variables de docker-compose.nube.yml (EC2 farmaexpress-mensajeria).
# Copiar como .env en la carpeta BACKEND de la EC2:  cp deploy/ec2/nube.env.example .env  && nano .env

# MySQL: IP PRIVADA de la EC2 farmaexpress-db y el usuario creado por instalar-mysql.sh
DB_HOST=CAMBIAR_IP_PRIVADA_BASE_DE_DATOS
DB_USER=farmaexpress
DB_PASSWORD=CAMBIAR

# RabbitMQ: usuario de los microservicios y secreto (cookie) del clúster. Usa valores largos y propios.
RABBITMQ_USER=farmaexpress
RABBITMQ_PASSWORD=CAMBIAR
RABBITMQ_COOKIE=CAMBIAR_TEXTO_LARGO_SIN_ESPACIOS

# Microsoft Entra ID (mismos valores que el frontend)
AZURE_TENANT_ID=CAMBIAR
AZURE_API_CLIENT_ID=CAMBIAR
# Solo si el "iss" de tus tokens no es login.microsoftonline.com/<tenant>/v2.0 (por ejemplo, External ID):
# AZURE_ISSUER=https://<tenant>.ciamlogin.com/<tenant>/v2.0

# Pagos: a dónde vuelve el navegador después de pagar.
PAGOS_URL_RETORNO=https://CAMBIAR_API_ID.execute-api.us-east-1.amazonaws.com/api/bff/payments/retorno
FRONTEND_URL=https://main.d1gism6shpd81i.amplifyapp.com
